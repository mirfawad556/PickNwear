generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  isFirstLogin Boolean  @default(true)
  whatsapp     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String?
  resetCode    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String   @id @default(uuid())
  name             String
  price            Float
  description      String
  discountPercent  Float    @default(0)
  specialOffers    String?
  clothingType     String
  colors           String
  category         String   // Male, Female, Child
  image            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
